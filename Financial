<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Exploring Modern Solution</title>

  <!-- PYSCRIPT CDN LINKS -->
  <link rel="stylesheet" href="https://pyscript.net/releases/2024.1.1/core.css">
  <script type="module" src="https://pyscript.net/releases/2024.1.1/core.js"></script>

  <style>
    /* CSS RESETS & VARIABLES */
    :root {
      --primary-color: #d97706;
      --primary-hover: #b45309;
      --text-dark: #292524;
      --text-muted: #787166;
      --bg-light: #fff2cc;
      --white: #ffffff;
      --font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      --border-radius: 8px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-family);
      color: var(--text-dark);
      background-color: var(--white);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* NAVIGATION */
    .navbar {
      background-color: var(--white);
      border-bottom: 1px solid #e9ecef;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 70px;
    }

    .brand-logo {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--primary-color);
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
      list-style: none;
    }

    .nav-links a {
      font-weight: 500;
      color: var(--text-dark);
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--primary-color);
    }

    .btn {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      font-weight: 600;
      border-radius: var(--border-radius);
      cursor: pointer;
      border: none;
      transition: background-color 0.2s, transform 0.1s;
    }

    .btn-primary {
      background-color: var(--primary-color);
      color: var(--white);
    }

    .btn-primary:hover {
      background-color: var(--primary-hover);
    }

    /* HERO SECTION */
    .hero {
      padding: 5rem 0;
      background: linear-gradient(135deg, #f0f4ff 0%, #ffffff 100%);
      text-align: center;
    }

    .hero-content {
      max-width: 800px;
      margin: 0 auto;
    }

    .hero h1 {
      font-size: 2.8rem;
      font-weight: 800;
      margin-bottom: 1.25rem;
      line-height: 1.2;
    }

    .hero p {
      font-size: 1.2rem;
      color: var(--text-muted);
      margin-bottom: 2rem;
    }

    /* HERO IMAGE STYLING */
    .hero-img {
      width: 100%;
      max-width: 650px;
      height: auto;
      border-radius: var(--border-radius);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      margin: 1.5rem auto;
      display: block;
    }

    /* FEATURES SECTION */
    .features {
      padding: 5rem 0;
    }

    .section-title {
      text-align: center;
      font-size: 2rem;
      margin-bottom: 3rem;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
    }

    .card {
      background-color: var(--bg-light);
      padding: 2rem;
      border-radius: var(--border-radius);
      border: 1px solid #e9ecef;
      transition: transform 0.2s;
    }

    .card:hover {
      transform: translateY(-4px);
    }

    /* CARD IMAGE STYLING */
    .card-img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      border-radius: calc(var(--border-radius) - 2px);
      margin-bottom: 1rem;
    }

    .card h3 {
      margin-bottom: 0.75rem;
    }

    .card p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* ABOUT / STATS SECTION */
    .about {
      background-color: var(--bg-light);
      padding: 5rem 0;
    }

    .about-content {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 3rem;
    }

    .about-text {
      flex: 1 1 400px;
    }

    .about-text h2 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .about-text p {
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }

    .stats-grid {
      flex: 1 1 300px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .stat-card {
      background: var(--white);
      padding: 1.5rem;
      border-radius: var(--border-radius);
      text-align: center;
      border: 1px solid #e9ecef;
    }

    .stat-number {
      font-size: 2rem;
      font-weight: 700;
      color: var(--primary-color);
    }

    /* CALCULATOR SECTION */
    .calculator-section {
      padding: 4rem 0;
      background-color: #f8fafc;
      border-top: 1px solid #e2e8f0;
      border-bottom: 1px solid #e2e8f0;
    }

    .calc-card {
      max-width: 600px;
      margin: 0 auto;
      background: var(--white);
      padding: 2.5rem;
      border-radius: var(--border-radius);
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .calc-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .calc-result {
      margin-top: 1.5rem;
      padding: 1.25rem;
      background-color: var(--bg-light);
      border-radius: var(--border-radius);
      border: 1px solid #fde68a;
      display: none;
    }

    .calc-result h4 {
      color: var(--primary-hover);
      margin-bottom: 0.5rem;
    }

    /* CONTACT SECTION */
    .contact {
      padding: 5rem 0;
    }

    .contact-form {
      max-width: 600px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      text-align: left;
    }

    .form-group label {
      font-weight: 600;
      font-size: 0.9rem;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #ced4da;
      border-radius: var(--border-radius);
      font-family: inherit;
      font-size: 1rem;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--primary-color);
    }

    /* FOOTER */
    footer {
      background-color: #111827;
      color: #9ca3af;
      padding: 3rem 0 1.5rem;
      text-align: center;
      font-size: 0.9rem;
    }

    footer p {
      margin-top: 1rem;
    }

    /* RESPONSIVE DESIGN ADJUSTMENTS */
    @media (max-width: 768px) {
      .hero h1 {
        font-size: 2.1rem;
      }

      .nav-links {
        display: none;
      }
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="container nav-container">
      <a href="#" class="brand-logo">Enterprise.io</a>
      <ul class="nav-links">
        <li><a href="#features">Services</a></li>
        <li><a href="#calculator">Calculator</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <a href="#contact" class="btn btn-primary">Get Started</a>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="container hero-content">
      <h1>Grow Your Business with Modern Solutions</h1>
      <p>We provide comprehensive strategies, operational guidance, and technical infrastructure tailored to elevate your business operations.</p>
      
      <!-- HERO SAMPLE IMAGE -->
      <img src="https://picsum.photos/650/350" alt="Modern Business Infrastructure" class="hero-img">

      <div id="python-output" style="margin-top: 15px; font-weight: bold; color: var(--primary-color);"></div>

      <a href="#contact" class="btn btn-primary" style="margin-top: 15px;">Request Consultation</a>
    </div>
  </section>

  <!-- SERVICES / FEATURES -->
  <section id="features" class="features">
    <div class="container">
      <h2 class="section-title">Our Core Capabilities</h2>
      <div class="grid-3">
        <div class="card">
          <!-- CARD IMAGE 1 -->
          <img src="https://picsum.photos/300/160?random=1" alt="Financial Analytics" class="card-img">
          <h3>Financial & Reconciliation</h3>
          <p>Streamline corporate accounting, revenue schedules, and internal record verification seamlessly.</p>
        </div>
        <div class="card">
          <!-- CARD IMAGE 2 -->
          <img src="https://picsum.photos/300/160?random=2" alt="Operational Strategy" class="card-img">
          <h3>Operational Strategy</h3>
          <p>Optimize organizational workflows, documentation standards, and project planning timelines.</p>
        </div>
        <div class="card">
          <!-- CARD IMAGE 3 -->
          <img src="https://picsum.photos/300/160?random=3" alt="Enterprise Compliance" class="card-img">
          <h3>Enterprise Compliance</h3>
          <p>Ensure structural, legal, and operational frameworks adhere strictly to regulatory standards.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE PYTHON CALCULATOR SECTION -->
  <section id="calculator" class="calculator-section">
    <div class="container">
      <h2 class="section-title">Financial Repayment Estimator</h2>
      <div class="calc-card">
        <div class="calc-form">
          <div class="form-group">
            <label for="principal">Principal Amount (₱ / $)</label>
            <input type="number" id="principal" value="100000" step="1000">
          </div>
          <div class="form-group">
            <label for="rate">Annual Interest Rate (%)</label>
            <input type="number" id="rate" value="7.5" step="0.1">
          </div>
          <div class="form-group">
            <label for="years">Term Duration (Years)</label>
            <input type="number" id="years" value="5" step="1">
          </div>
          
          <!-- PyScript event listener trigger -->
          <button py-click="calculate_payment" class="btn btn-primary">Calculate Schedule</button>
        </div>

        <div id="calc-result" class="calc-result">
          <h4>Calculation Summary</h4>
          <p id="calc-output"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT & STATS -->
  <section id="about" class="about">
    <div class="container">
      <div class="about-content">
        <div class="about-text">
          <h2>Proven Expertise & Reliability</h2>
          <p>Backed by decades of administrative, structural, and corporate managerial experience, our team ensures every asset, record, and initiative achieves peak reliability and performance.</p>
          <a href="#contact" class="btn btn-primary">Learn More</a>
        </div>
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-number">30+</div>
            <div>Years Experience</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">100%</div>
            <div>Client Satisfaction</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">250+</div>
            <div>Projects Delivered</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">24/7</div>
            <div>Dedicated Support</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section id="contact" class="contact">
    <div class="container">
      <h2 class="section-title">Contact Us</h2>
      <form class="contact-form" onsubmit="event.preventDefault(); alert('Message sent successfully!');">
        <div class="form-group">
          <label for="name">Full Name</label>
          <input type="text" id="name" placeholder="John Doe" required>
        </div>
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" placeholder="name@company.com" required>
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" rows="5" placeholder="How can we help you?" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send Message</button>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="container">
      <p>&copy; 2026 Enterprise.io. All rights reserved.</p>
    </div>
  </footer>

  <!-- PYTHON LOGIC SCRIPT -->
  <script type="py">
    from pyscript import display, document
    import datetime

    # Display initial load message in hero section
    current_time = datetime.datetime.now().strftime("%B %d, %Y")
    display(f"Python Engine Active • System Ready ({current_time})", target="python-output")

    # Interactive Function linked to py-click="calculate_payment"
    def calculate_payment(event):
        try:
            # Read DOM input values
            p = float(document.getElementById("principal").value)
            annual_rate = float(document.getElementById("rate").value)
            years = int(document.getElementById("years").value)

            # Financial calculation formula (Monthly Payment)
            monthly_rate = (annual_rate / 100) / 12
            total_months = years * 12

            if monthly_rate > 0:
                monthly_payment = (p * monthly_rate * (1 + monthly_rate)**total_months) / ((1 + monthly_rate)**total_months - 1)
            else:
                monthly_payment = p / total_months

            total_paid = monthly_payment * total_months
            total_interest = total_paid - p

            # Format text output
            result_text = f"Monthly Payment: {monthly_payment:,.2f} | Total Interest: {total_interest:,.2f} | Total Paid: {total_paid:,.2f}"

            # Make result container visible and populate content
            document.getElementById("calc-result").style.display = "block"
            document.getElementById("calc-output").innerText = result_text

        except Exception as e:
            document.getElementById("calc-result").style.display = "block"
            document.getElementById("calc-output").innerText = f"Please enter valid numeric values. Error: {str(e)}"
  </script>

</body>
